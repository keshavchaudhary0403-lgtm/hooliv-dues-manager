# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon/public key (Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Domain used to synthesize login emails from phone numbers ({phone}@THIS).
# MUST match the AUTH_EMAIL_DOMAIN secret set on the admin-users Edge Function.
VITE_AUTH_EMAIL_DOMAIN=hooliv.local
